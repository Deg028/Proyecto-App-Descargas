# Copia este archivo como ".env" y completa los valores (el archivo .env no se sube a git).

# Inicio de sesión con Google (opcional). Credenciales de tipo "ID de cliente de OAuth" en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dirección con la que Google vuelve a la app. Debe coincidir EXACTAMENTE con el "URI de redireccionamiento autorizado":
# http://localhost:3000/auth/google/callback
PUBLIC_URL=http://localhost:3000

# PORT=3000
# HOST=127.0.0.1

# Clave de acceso cuando HOST no es localhost (p. ej. 0.0.0.0 para el móvil). Si la dejas vacía se genera una
# y se guarda en data/token.txt. Quien no esté en este PC debe abrir Tonea con ?t=CLAVE (npm run qr ya la incluye).
# TONEA_TOKEN=

# Clave de la YouTube Data API v3 (opcional). Con ella la búsqueda usa la API oficial; sin ella se usa yt-dlp.
YOUTUBE_API_KEY=

# yt-dlp (opcional)
# Cookies para sitios que exigen sesión (Instagram…): firefox | edge | chrome. También vale un data/cookies.txt.
# COOKIES_FROM_BROWSER=firefox
# Intérprete de JavaScript para YouTube (por defecto, Node.js del sistema).
# JS_RUNTIME=C:\Program Files\nodejs\node.exe
# Desactiva la actualización automática de yt-dlp.
# TONEA_NO_AUTOUPDATE=1
