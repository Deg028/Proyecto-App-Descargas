{
  "name": "tonea",
  "version": "1.1.0",
  "description": "Tonea: descarga y convierte videos pegando un enlace (video o MP3).",
  "main": "main.js",
  "scripts": {
    "setup": "node setup.js",
    "postinstall": "node setup.js",
    "start": "node server.js",
    "app": "electron .",
    "qr": "node qr.js",
    "contrast": "node scripts/contrast.js",
    "app:debug": "electron . --debug",
    "app:movil": "electron . --size=390x844 --debug",
    "update-ytdlp": "node setup.js --update"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  }
}
